---
// Footer for the inner pages. The home page carries the same imprint inside
// its closing chapter, so the last leaf of the book ends the book.
import Imprint from "./Imprint.astro";
---

<footer class="colophon-foot">
  <div class="wrap">
    <Imprint />
  </div>
</footer>

<style>
  .colophon-foot {
    border-top: 1px solid var(--hairline-soft);
    background: var(--surface-low);
    padding-top: 1rem;
    /* Was 0: the endmark line used to close the page out. */
    padding-bottom: 3.5rem;
  }
</style>
