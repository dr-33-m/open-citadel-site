---
// Running head. The app's own chrome, worn by the page: PROGRESS mirrors the
// reading progress bar on a book card inside Open Citadel.
interface Props {
  /** The home page turns into a book on phones, so its links turn leaves. */
  bookMode?: boolean;
}

const { bookMode = false } = Astro.props;

const links = bookMode
  ? [
      { label: "Becoming", href: "#becoming" },
      { label: "How it works", href: "#loop" },
      { label: "Samwell", href: "#samwell" },
    ]
  : [
      { label: "Home", href: "/" },
      { label: "Support", href: "/support" },
      { label: "Privacy", href: "/privacy" },
    ];

// Never a direct store link. Both CTAs land on Chapter IV, which names both
// platforms, so nothing here has to guess which device the reader owns. In
// book mode BookChrome intercepts the bare hash and turns the page instead.
const ctaHref = bookMode ? "#acquire" : "/#acquire";
---

<header class="runhead">
  <div class="wrap runhead-row">
    <a href="/" class="brand" aria-label="Open Citadel home">
      <img src="/app-icon.png" alt="" width="52" height="52" />
      <span>Open Citadel</span>
    </a>

    <div class="progress-meter" role="group" aria-label="Reading progress">
      <p class="label">Progress</p>
      <div class="progress-track">
        <div class="progress-fill" id="progress-fill"></div>
      </div>
      <span class="progress-pct" id="progress-pct">0%</span>
    </div>

    <div class="runhead-right">
      <button
        class="icon-btn"
        id="theme-toggle"
        type="button"
        aria-label="Toggle light or dark theme"
      >
        <svg
          class="icon-sun"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg
          class="icon-moon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <a class="btn btn-sm" href={ctaHref}>Get the app</a>

      <button
        class="icon-btn menu-btn"
        id="menu-open"
        type="button"
        aria-label="Open menu"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <line x1="3" y1="7" x2="21" y2="7"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="17" x2="15" y2="17"></line>
        </svg>
      </button>
    </div>
  </div>
</header>

<div class="menu-sheet" id="menu-sheet">
  <button class="menu-close" id="menu-close" type="button" aria-label="Close menu"
    >&times;</button
  >
  {links.map(({ label, href }) => <a href={href}>{label}</a>)}
  <a class="btn" href={ctaHref}>Get the app</a>
</div>

<script>
  // Theme, menu, and the reading progress meter. Runs on every page.
  const root = document.documentElement;

  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const isLight = root.getAttribute("data-theme") === "light";
    if (isLight) {
      root.removeAttribute("data-theme");
      localStorage.setItem("oc-theme", "dark");
    } else {
      root.setAttribute("data-theme", "light");
      localStorage.setItem("oc-theme", "light");
    }
  });

  const sheet = document.getElementById("menu-sheet");
  document.getElementById("menu-open")?.addEventListener("click", () => {
    sheet?.classList.add("open");
  });
  document.getElementById("menu-close")?.addEventListener("click", () => {
    sheet?.classList.remove("open");
  });
  sheet?.querySelectorAll("a").forEach((anchor) => {
    anchor.addEventListener("click", () => sheet.classList.remove("open"));
  });

  // In book mode the reading position is horizontal, not vertical.
  const leafScroller = document.querySelector("main");
  const bookQuery = window.matchMedia("(max-width: 899px)");
  const isBook = () => root.classList.contains("book") && bookQuery.matches;

  const fill = document.getElementById("progress-fill");
  const pct = document.getElementById("progress-pct");

  function readingRatio() {
    if (isBook() && leafScroller) {
      const span = leafScroller.scrollWidth - leafScroller.clientWidth;
      return span > 0 ? leafScroller.scrollLeft / span : 0;
    }
    const max = root.scrollHeight - window.innerHeight;
    return max > 0 ? window.scrollY / max : 0;
  }

  let ticking = false;
  function updateProgress() {
    const value = Math.max(0, Math.min(100, Math.round(readingRatio() * 100)));
    if (fill) fill.style.width = `${value}%`;
    if (pct) pct.textContent = `${value}%`;
    ticking = false;
  }
  function onScroll() {
    if (!ticking) {
      ticking = true;
      window.requestAnimationFrame(updateProgress);
    }
  }

  window.addEventListener("scroll", onScroll, { passive: true });
  leafScroller?.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", updateProgress);
  updateProgress();
</script>
