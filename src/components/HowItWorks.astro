---
// Chapter II. The Compass journey as an ascent: on wide screens the steps rise
// in two rows of three, because growth has a direction.
//
// The kicker, intro, and most step copy come from the app's About Compass
// sheet (open-citadel: src/features/compass/components/about-compass-sheet.tsx)
// so the site and the app describe Compass in the same words. Change them
// together.
import reader from "../assets/screenshots/light/01-reader.webp";
import plan from "../assets/screenshots/light/02-plan.webp";
import logDeck from "../assets/screenshots/light/04-log-deck.webp";
import planner from "../assets/screenshots/light/05-planner.webp";
import checkin from "../assets/screenshots/light/06-checkin.webp";
import takeaway from "../assets/screenshots/light/10-takeaway.webp";

const stages = [
  {
    order: "01",
    title: "Read and highlight",
    body: "Bring in your EPUBs and read without distraction. Highlight the lines that matter and write down what they mean to you.",
    shot: reader,
    alt: "The reader, with two passages from Franklin's autobiography highlighted",
  },
  {
    order: "02",
    title: "Set a goal",
    body: "Tell Samwell what you want to change, in your own words. He helps you shape it into a goal made of small things you can actually do.",
    shot: plan,
    alt: "Samwell proposing a goal, Learn to TIG weld properly, with three things to log",
  },
  {
    order: "03",
    title: "Log your days",
    body: "A few taps a day. Did you show up, and how did it go? That is all it asks.",
    shot: logDeck,
    alt: "Today's log card: Draw one thing from life, with 1 sketch logged",
  },
  {
    order: "04",
    title: "Check in with Samwell",
    body: "Stuck or drifting? Talk it through. He can see what you have logged and what you wrote, so his advice is about your life, not someone else's.",
    shot: checkin,
    alt: "A check-in where Samwell quotes recent logs, notes, and a highlight",
  },
  {
    order: "05",
    title: "See how far you have come",
    body: "The planner and insights show your consistency over time. It counts consistency, not streaks, so one missed day never wipes out the rest.",
    shot: planner,
    alt: "The planner: a month calendar marking the days that were done, missed, and due",
  },
  {
    order: "06",
    title: "Finish what you started",
    body: "When a goal ends, Samwell writes down what it taught you, so the next one starts smarter.",
    shot: takeaway,
    alt: "A finished goal, Fill a sketchbook like Leonardo, with the note What Samwell took from it",
  },
];
---

<section class="chapter loop chapter-rule" id="loop">
  <div class="wrap">
    <div class="chapter-mark">
      <span class="chapter-num">II</span>
      <span class="rule"></span>
      <span class="label label-dim">How It Works</span>
    </div>

    <h2 class="reveal">A book only changes you when you act on it.</h2>

    <div class="loop-intro">
      <p>
        You finish a book full of good ideas. A week later, most of them have
        slipped away. Nothing happened after the last page.
      </p>
      <p>
        <strong>Compass</strong> is where something happens next.
      </p>
    </div>

    <div class="steps">
      {
        stages.map((stage) => (
          <div class="step-item">
            <div class="step-shot">
              <img
                src={stage.shot.src}
                width={stage.shot.width}
                height={stage.shot.height}
                alt={stage.alt}
                loading="lazy"
              />
            </div>
            <div class="step-text">
              <p class="label">{stage.order}</p>
              <h3>{stage.title}</h3>
              <p>{stage.body}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
