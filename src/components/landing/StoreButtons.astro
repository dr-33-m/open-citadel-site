---
// The two ways in, in ink, at equal weight. IOS_LIVE flips the iOS button
// between the listing and the waitlist.
import {
  PLAY_STORE_URL,
  APP_STORE_URL,
  IOS_LIVE,
  IOS_WAITLIST_URL,
} from "../../consts";
import Android from "../icons/Android.astro";

const iosHref = IOS_LIVE ? APP_STORE_URL : IOS_WAITLIST_URL;
const iosLabel = IOS_LIVE ? "Download on the" : "Join the waitlist for";
---

<div class="stores">
  <a class="store" href={PLAY_STORE_URL}>
    <Android />
    <span>
      <span class="s-label">Get it on</span>
      <span class="s-name">Google Play</span>
    </span>
  </a>
  <a class="store" href={iosHref}>
    <svg viewBox="0 0 814 1000" aria-hidden="true">
      <path
        fill="currentColor"
        d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"
      ></path>
    </svg>
    <span>
      <span class="s-label">{iosLabel}</span>
      <span class="s-name">App Store</span>
    </span>
  </a>
</div>

<style>
  .stores {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .store {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    min-width: 13.5rem;
    padding: 0.9rem 1.5rem;
    background: var(--text);
    color: var(--bg);
    text-decoration: none;
    text-align: left;
    transition: opacity 120ms cubic-bezier(0.33, 1, 0.68, 1);
  }
  .store:hover {
    opacity: 0.86;
  }
  .store:active {
    opacity: 0.6;
  }
  .store :global(svg) {
    width: 22px;
    height: 22px;
    flex: 0 0 auto;
  }
  .store > span {
    display: flex;
    flex-direction: column;
  }
  .s-label {
    font-family: "Manrope", sans-serif;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.75;
  }
  .s-name {
    font-family: "Newsreader", Georgia, serif;
    font-weight: 600;
    font-size: 1.12rem;
    line-height: 1.2;
  }
  @media (max-width: 560px) {
    .store {
      width: 100%;
    }
  }
</style>
