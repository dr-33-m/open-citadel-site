---
// A Pixel-style phone drawn in plain CSS, with whatever is slotted in as its
// screen. Every edge is a solid fill or a 1px ring with no blur, so it stays
// crisp at any size. Proportions follow a Pixel: 19.5:9 screen, thin even
// bezel, corners about 11.5% of the width. Size it with --phone-w.
---

<div class="phone">
  <span class="btn-power" aria-hidden="true"></span>
  <span class="btn-volume" aria-hidden="true"></span>
  <div class="bezel">
    <div class="screen"><slot /></div>
    <span class="camera" aria-hidden="true"></span>
  </div>
</div>

<style>
  .phone {
    --w: var(--phone-w, 300px);
    --bez: calc(var(--w) * 0.032);
    --r: calc(var(--w) * 0.115);
    position: relative;
    width: var(--w);
    padding: calc(var(--w) * 0.012);
    border-radius: var(--r) !important;
    background: var(--phone-rim);
    box-shadow:
      0 0 0 1px var(--phone-edge),
      var(--phone-shadow);
  }
  .bezel {
    position: relative;
    padding: var(--bez);
    border-radius: calc(var(--r) - var(--w) * 0.012) !important;
    background: #0b0b0c;
  }
  .screen {
    position: relative;
    aspect-ratio: 9 / 19.5;
    overflow: hidden;
    border-radius: calc(var(--r) - var(--w) * 0.012 - var(--bez)) !important;
    background: #f5eee0;
    isolation: isolate;
  }
  .screen > :global(*) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }
  .camera {
    position: absolute;
    top: calc(var(--bez) + var(--w) * 0.03);
    left: 50%;
    width: calc(var(--w) * 0.034);
    aspect-ratio: 1;
    transform: translateX(-50%);
    border-radius: 50% !important;
    background: #0b0b0c;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
    z-index: 2;
  }
  .btn-power,
  .btn-volume {
    position: absolute;
    right: -2px;
    width: 3px;
    border-radius: 0 2px 2px 0 !important;
    background: var(--phone-rim);
    box-shadow: 1px 0 0 var(--phone-edge);
  }
  .btn-power {
    top: 22%;
    height: 7%;
  }
  .btn-volume {
    top: 33%;
    height: 13%;
  }
</style>
