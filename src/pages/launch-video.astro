---
// The launch video, on its own page for sharing. Not indexed.
import Layout from "../layouts/Layout.astro";
import Masthead from "../components/Masthead.astro";
---

<Layout
  title="Launch Video: Open Citadel"
  description="The Open Citadel launch video."
  noindex={true}
>
  <Masthead />
  <main class="wrap stage">
    <p class="eyebrow">Launch video</p>
    <video src="/videos/open-citadel-launch.mp4" controls playsinline preload="metadata"></video>
  </main>
</Layout>

<style>
  .stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    padding-block: clamp(2rem, 8vh, 5rem);
  }
  .eyebrow {
    margin: 0;
    font-family: "Manrope", sans-serif;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  video {
    display: block;
    width: 100%;
    max-width: 64rem;
    background: #000;
    box-shadow:
      0 0 0 1px var(--hairline),
      var(--phone-shadow);
  }
</style>
