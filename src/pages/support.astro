---
// Support. The form writes an email in the visitor's own mail app, so nothing
// is sent until they press send there.
import DocPage from "../layouts/DocPage.astro";
import { CONTACT_EMAIL } from "../consts";
---

<DocPage
  title="Support: Open Citadel"
  description="Contact Open Citadel support with your name, email, and feedback."
  eyebrow="Support"
  heading="Contact Open Citadel Support"
>
  <p slot="intro">
    Send feedback, bug reports, or questions about Open Citadel. This form opens
    your device's email app so you can review and send the message yourself.
  </p>

  <section>
    <form id="support-form" class="form" data-to={CONTACT_EMAIL}>
      <label>
        <span>Name</span>
        <input name="name" type="text" autocomplete="name" required />
      </label>
      <label>
        <span>Email</span>
        <input name="email" type="email" autocomplete="email" required />
      </label>
      <label>
        <span>Message</span>
        <textarea name="message" rows="8" required></textarea>
      </label>
      <div class="send">
        <button type="submit">Open email app</button>
        <p id="support-status" class="status" aria-live="polite">
          Nothing is sent until you press send in your email app.
        </p>
      </div>
    </form>
  </section>

  <section>
    <h2>Prefer to email directly?</h2>
    <p>
      You can also contact support at
      <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
    </p>
  </section>
</DocPage>

<style>
  .form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  label {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  label span {
    font-family: "Manrope", sans-serif;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text);
  }
  input,
  textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    font-family: "Newsreader", Georgia, serif;
    font-size: 1.08rem;
    color: var(--text);
    background: var(--surface-low);
    border: 1px solid var(--hairline);
    outline: none;
    transition: border-color 180ms cubic-bezier(0.33, 1, 0.68, 1);
  }
  textarea {
    resize: vertical;
  }
  input:focus,
  textarea:focus {
    border-color: var(--text);
  }
  .send {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    margin-top: 0.5rem;
  }
  button {
    padding: 1rem 2rem;
    font-family: "Newsreader", Georgia, serif;
    font-weight: 600;
    font-size: 1rem;
    color: var(--bg);
    background: var(--text);
    border: 0;
    cursor: pointer;
    transition: opacity 120ms cubic-bezier(0.33, 1, 0.68, 1);
  }
  button:hover {
    opacity: 0.86;
  }
  button:active {
    opacity: 0.6;
  }
  .status {
    font-family: "Manrope", sans-serif;
    font-size: 0.8rem;
    line-height: 1.5;
  }
</style>

<script>
  const form = document.getElementById("support-form");
  const status = document.getElementById("support-status");

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement) || !form.reportValidity()) return;

    const data = new FormData(form);
    const field = (key: string) => String(data.get(key) || "").trim();
    const subject = encodeURIComponent("Open Citadel support request");
    const body = encodeURIComponent(
      [
        "Open Citadel Support Request",
        "",
        `Name: ${field("name")}`,
        `Email: ${field("email")}`,
        "",
        "Message:",
        field("message"),
      ].join("\n"),
    );

    window.location.href = `mailto:${form.dataset.to}?subject=${subject}&body=${body}`;
    if (status) status.textContent = "Opening your email app...";
  });
</script>
