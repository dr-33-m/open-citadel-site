---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const supportEmail = "thamsanqa.dev@gmail.com";
---

<Layout
  title="Support — Open Citadel"
  description="Contact Open Citadel support with your name, email, and feedback."
>
  <Nav />
  <main class="pt-32 pb-24 px-6 md:px-12 lg:px-20 bg-obsidian">
    <div class="max-w-3xl mx-auto flex flex-col gap-12">
      <header class="flex flex-col gap-4">
        <p
          class="font-body text-xs font-semibold text-gold uppercase tracking-[0.12em] m-0"
        >
          Support
        </p>
        <h1
          class="font-display text-parchment m-0 leading-[1.1]"
          style="font-size: clamp(2rem, 4vw, 2.75rem); font-weight: 400;"
        >
          Contact Open Citadel Support
        </h1>
        <p class="font-body text-parchment-dim leading-relaxed m-0">
          Send feedback, bug reports, or questions about Open Citadel. This
          form opens your device's email app so you can review and send the
          message yourself.
        </p>
      </header>

      <section
        class="bg-surface-low p-6 md:p-8"
        style="border: 1px solid rgba(208,197,175,0.08);"
      >
        <form id="support-form" class="flex flex-col gap-6">
          <label class="flex flex-col gap-2 font-body text-sm text-parchment">
            Name
            <input
              name="name"
              type="text"
              autocomplete="name"
              required
              class="bg-obsidian text-parchment px-4 py-3 font-body outline-none"
              style="border: 1px solid rgba(208,197,175,0.16);"
            />
          </label>

          <label class="flex flex-col gap-2 font-body text-sm text-parchment">
            Email
            <input
              name="email"
              type="email"
              autocomplete="email"
              required
              class="bg-obsidian text-parchment px-4 py-3 font-body outline-none"
              style="border: 1px solid rgba(208,197,175,0.16);"
            />
          </label>

          <label class="flex flex-col gap-2 font-body text-sm text-parchment">
            Message
            <textarea
              name="message"
              rows="8"
              required
              class="bg-obsidian text-parchment px-4 py-3 font-body outline-none resize-y"
              style="border: 1px solid rgba(208,197,175,0.16);"
            ></textarea>
          </label>

          <div class="flex flex-col sm:flex-row sm:items-center gap-4">
            <button
              type="submit"
              class="inline-flex justify-center px-6 py-3 font-display text-sm font-semibold text-ink uppercase tracking-[0.08em] transition-opacity duration-200 hover:opacity-90"
              style="background: linear-gradient(135deg, #f2ca50, #d4af37);"
            >
              Open email app
            </button>
            <p
              id="support-status"
              aria-live="polite"
              class="font-body text-sm text-parchment-dim m-0"
            >
              Nothing is sent until you press send in your email app.
            </p>
          </div>
        </form>
      </section>

      <section class="flex flex-col gap-3">
        <h2 class="font-display text-gold text-2xl font-medium m-0">
          Prefer to email directly?
        </h2>
        <p class="font-body text-parchment-dim leading-relaxed m-0">
          You can also contact support at
          <a class="text-gold hover:opacity-80" href={`mailto:${supportEmail}`}>
            {supportEmail}
          </a>.
        </p>
      </section>
    </div>
  </main>
  <Footer />

  <script>
    const form = document.getElementById("support-form");
    const status = document.getElementById("support-status");

    form?.addEventListener("submit", (event) => {
      event.preventDefault();

      if (!(form instanceof HTMLFormElement)) return;
      if (!form.reportValidity()) return;

      const data = new FormData(form);
      const name = String(data.get("name") || "").trim();
      const email = String(data.get("email") || "").trim();
      const message = String(data.get("message") || "").trim();

      const subject = encodeURIComponent("Open Citadel support request");
      const body = encodeURIComponent(
        [
          "Open Citadel Support Request",
          "",
          `Name: ${name}`,
          `Email: ${email}`,
          "",
          "Message:",
          message,
        ].join("\n")
      );

      window.location.href = `mailto:thamsanqa.dev@gmail.com?subject=${subject}&body=${body}`;

      if (status) {
        status.textContent = "Opening your email app...";
      }
    });
  </script>
</Layout>
