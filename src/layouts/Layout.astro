---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /**
   * Turns the page into a swipeable book on phones (one section per leaf).
   * Only the home page opts in; long documents like privacy and support
   * must keep normal vertical scrolling.
   */
  bookMode?: boolean;
}

const {
  title = "Open Citadel: Your Companion in Becoming",
  description = "Open Citadel helps you reflect on what you learn, connect the ideas that shape you, and turn knowledge into growth. Your personal library, reader, and self-development companion.",
  noindex = false,
  bookMode = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" class={bookMode ? "book" : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="icon" type="image/png" href="/app-icon.png" />
    <title>{title}</title>

    <!-- Google Fonts: Newsreader (display) + Manrope (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,300;1,6..72,400;1,6..72,500&family=Manrope:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Restore saved theme before paint to avoid flash -->
    <script is:inline>
      (function () {
        const t = localStorage.getItem("oc-theme");
        if (t === "light")
          document.documentElement.setAttribute("data-theme", "light");
      })();
    </script>
    <Analytics />
  </head>
  <body class="bg-obsidian text-parchment font-body book-page">
    <slot />
  </body>
</html>
