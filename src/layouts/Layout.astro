---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** The theme a first-time visitor sees. A saved choice always wins. */
  defaultTheme?: "light" | "dark";
}

const {
  title = "Open Citadel: Your Companion in Becoming 2.0",
  description = "Read your books, highlight what matters, and turn it into goals you keep. Open Citadel pairs a focused reader with Samwell, a companion who helps you plan, check in, and see your progress.",
  noindex = false,
  defaultTheme = "dark",
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme={defaultTheme === "light" ? "light" : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="icon" type="image/png" href="/app-icon.png" />
    <title>{title}</title>

    <!-- Google Fonts: Newsreader (display) + Manrope (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,300;1,6..72,400;1,6..72,500&family=Manrope:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Restore saved theme before paint to avoid flash -->
    <script is:inline>
      (function () {
        let t = null;
        try {
          t = localStorage.getItem("oc-theme");
        } catch (e) {}
        if (t === "light")
          document.documentElement.setAttribute("data-theme", "light");
        else if (t === "dark")
          document.documentElement.removeAttribute("data-theme");
      })();
    </script>
    <Analytics />
  </head>
  <body class="bg-obsidian text-parchment font-body book-page">
    <slot />
  </body>
</html>
