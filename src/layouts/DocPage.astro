---
// Every page that is something to read (privacy, terms, account deletion,
// support) wears the home page's design: the same masthead, the same type
// and ground, the same imprint to close. Headings are ink, not gold; on these
// pages gold keeps the one meaning it has on the home page, progress: a
// reading line along the top, and the section you are in on the contents.
//
// The page's own text goes in the default slot as plain sections, headings,
// paragraphs and lists; this layout styles them. `intro` is an optional
// paragraph under the title.
import Layout from "./Layout.astro";
import Masthead from "../components/Masthead.astro";
import Imprint from "../components/Imprint.astro";

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  updated?: string;
  sections?: { id: string; label: string }[];
}
const { title, description, eyebrow, heading, updated, sections } = Astro.props;
---

<Layout title={title} description={description}>
  <div class="reading" aria-hidden="true"><span id="reading-fill"></span></div>
  <Masthead nav />

  <main class="wrap doc">
    <header class="head">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{heading}</h1>
      {updated && <p class="updated">Last updated: {updated}</p>}
      {Astro.slots.has("intro") && <div class="lede"><slot name="intro" /></div>}
    </header>

    {
      sections && (
        <details class="toc" id="toc" open>
          <summary>On this page</summary>
          <ol>
            {sections.map(({ id, label }) => (
              <li>
                <a href={`#${id}`}>{label}</a>
              </li>
            ))}
          </ol>
        </details>
      )
    }

    <article class="prose"><slot /></article>
  </main>

  <footer class="wrap foot">
    <Imprint />
  </footer>
</Layout>

<style>
  .doc {
    --ease: cubic-bezier(0.33, 1, 0.68, 1);
    display: grid;
    grid-template-columns: 13rem minmax(0, 40rem);
    grid-template-areas:
      ".   head"
      "toc body";
    column-gap: clamp(3rem, 7vw, 7rem);
    padding-top: clamp(2.5rem, 8vh, 5rem);
  }

  /* ─── Title ── */
  .head {
    grid-area: head;
    padding-bottom: clamp(3rem, 7vh, 4.5rem);
  }
  .eyebrow {
    margin: 0;
    font-family: "Manrope", sans-serif;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  h1 {
    margin: 1rem 0 0;
    font-family: "Newsreader", Georgia, serif;
    font-weight: 400;
    font-size: clamp(2.5rem, 5.4vw, 4.4rem);
    line-height: 1.04;
    letter-spacing: -0.022em;
    color: var(--text);
    text-wrap: balance;
  }
  .updated {
    margin: 1.2rem 0 0;
    font-family: "Manrope", sans-serif;
    font-size: 0.8rem;
    color: var(--text-dim);
  }
  .lede {
    margin-top: 1.6rem;
    max-width: 36rem;
    font-family: "Newsreader", Georgia, serif;
    font-size: clamp(1.1rem, 1.4vw, 1.25rem);
    line-height: 1.6;
    color: var(--text-dim);
    text-wrap: pretty;
  }
  .lede :global(p) {
    margin: 0;
  }

  /* ─── Contents: sticky beside the text; the section you are in is gold ── */
  .toc {
    grid-area: toc;
    align-self: start;
    position: sticky;
    top: 2rem;
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
  }
  .toc summary {
    display: none;
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--hairline);
  }
  .toc a {
    display: block;
    margin-left: -1px;
    padding: 0.4rem 0 0.4rem 1rem;
    border-left: 2px solid transparent;
    font-family: "Manrope", sans-serif;
    font-size: 0.78rem;
    line-height: 1.4;
    color: var(--text-dim);
    text-decoration: none;
    transition:
      color 180ms var(--ease),
      border-color 180ms var(--ease);
  }
  .toc a:hover {
    color: var(--text);
  }
  .toc a[aria-current="true"] {
    color: var(--text);
    border-left-color: var(--gold);
  }

  /* ─── The text ── */
  .prose {
    grid-area: body;
    font-family: "Newsreader", Georgia, serif;
    font-size: 1.12rem;
    line-height: 1.7;
    color: var(--text-dim);
  }
  .prose :global(section) {
    scroll-margin-top: 2rem;
  }
  .prose :global(section + section),
  .prose > :global(p + section) {
    margin-top: 3.5rem;
  }
  .prose :global(h2) {
    margin: 0 0 1rem;
    font-family: "Newsreader", Georgia, serif;
    font-weight: 400;
    font-size: clamp(1.6rem, 2.4vw, 2rem);
    line-height: 1.15;
    letter-spacing: -0.012em;
    color: var(--text);
    text-wrap: balance;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0;
  }
  .prose :global(:is(p, ul, ol) + :is(p, ul, ol)) {
    margin-top: 1rem;
  }
  .prose :global(:is(ul, ol)) {
    padding-left: 1.3rem;
  }
  .prose :global(ul) {
    list-style: square;
  }
  .prose :global(ol) {
    list-style: decimal;
  }
  .prose :global(li + li) {
    margin-top: 0.5rem;
  }
  .prose :global(li::marker) {
    color: var(--text-dim);
  }
  .prose :global(strong) {
    font-weight: 600;
    color: var(--text);
  }
  .prose :global(a) {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--hairline);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    transition: text-decoration-color 180ms var(--ease);
  }
  .prose :global(a:hover),
  .prose :global(a:focus-visible) {
    text-decoration-color: var(--text);
  }
  .prose :global(.note) {
    font-family: "Manrope", sans-serif;
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .foot :global(.imprint) {
    margin-top: clamp(6rem, 14vh, 9rem);
    padding-bottom: 2rem;
  }

  /* ─── Reading progress, along the very top ── */
  .reading {
    position: fixed;
    inset: 0 0 auto;
    z-index: 10;
    height: 2px;
    pointer-events: none;
  }
  .reading span {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left;
  }

  /* ─── Phones: one column; the contents fold away above the text ── */
  @media (max-width: 899px) {
    .doc {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "head" "toc" "body";
    }
    .toc {
      position: static;
      max-height: none;
      margin-bottom: 3rem;
      border-top: 1px solid var(--hairline);
      border-bottom: 1px solid var(--hairline);
    }
    .toc summary {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem 0;
      cursor: pointer;
      list-style: none;
      font-family: "Manrope", sans-serif;
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--text);
    }
    .toc summary::-webkit-details-marker {
      display: none;
    }
    .toc summary::after {
      content: "+";
      font-size: 1rem;
      font-weight: 400;
    }
    .toc[open] summary::after {
      content: "−";
    }
    .toc ol {
      margin-bottom: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .toc a,
    .prose :global(a) {
      transition: none;
    }
  }
</style>

<script>
  // Reading progress along the top.
  const fill = document.getElementById("reading-fill");
  const root = document.documentElement;
  let ticking = false;
  function paint() {
    const max = root.scrollHeight - window.innerHeight;
    const r = max > 0 ? Math.min(Math.max(window.scrollY / max, 0), 1) : 0;
    if (fill) fill.style.transform = `scaleX(${r})`;
    ticking = false;
  }
  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(paint);
      }
    },
    { passive: true },
  );
  window.addEventListener("resize", paint);
  paint();

  // Contents: open beside the text on a wide screen, folded on a phone, and
  // the section you are reading marked.
  const toc = document.getElementById("toc") as HTMLDetailsElement | null;
  if (toc) {
    const wide = window.matchMedia("(min-width: 900px)");
    const fold = () => (toc.open = wide.matches);
    fold();
    wide.addEventListener("change", fold);
    toc.querySelectorAll("a").forEach((a) =>
      a.addEventListener("click", () => {
        if (!wide.matches) toc.open = false;
      }),
    );

    const links = new Map(
      Array.from(toc.querySelectorAll<HTMLAnchorElement>("a")).map((a) => [
        a.hash.slice(1),
        a,
      ]),
    );
    const sections = Array.from(links.keys())
      .map((id) => document.getElementById(id))
      .filter((s): s is HTMLElement => !!s);
    let current = "";
    function mark() {
      // The last section whose top has passed a third of the way down.
      const line = window.innerHeight / 3;
      let id = sections[0]?.id ?? "";
      for (const s of sections) if (s.getBoundingClientRect().top <= line) id = s.id;
      if (id !== current) {
        links.get(current)?.removeAttribute("aria-current");
        links.get(id)?.setAttribute("aria-current", "true");
        current = id;
      }
    }
    window.addEventListener("scroll", () => requestAnimationFrame(mark), { passive: true });
    mark();
  }
</script>
